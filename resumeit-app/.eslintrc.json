{
  "extends": ["next/core-web-vitals", "next"],
  "rules": {
    "react/no-unescaped-entities": "off",
    "@next/next/no-img-element": "off",
    "react-hooks/rules-of-hooks": "off",
    "react-hooks/exhaustive-deps": "warn"
  },
  "ignorePatterns": [
    "**/*.old.tsx",
    "**/*_old.tsx",
    "**/old/**",
    "node_modules/**"
  ]
}
