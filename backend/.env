# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=resumeit-secret-key-2025
DEBUG=True

# Database Configuration (SQLite)
SQLITE_DB_PATH=/workspaces/Candidate-Recommendation-System/backend/resumeit.db

# PostgreSQL Configuration (Optional - for production)
DATABASE_URL=postgresql://postgres:password@localhost:5432/resumeit_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resumeit_db
DB_USER=postgres
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-key-resumeit-2025
JWT_ACCESS_TOKEN_EXPIRES=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# AWS S3 Configuration (Optional - for production)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=resumeit-storage
AWS_REGION=us-east-1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=app/static/uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,txt

# Model Configuration
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.3
TOP_CANDIDATES_LIMIT=10
